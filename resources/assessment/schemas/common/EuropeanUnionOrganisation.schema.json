{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "An European Union organisation such as an institution, agency or body.",
  "required": [
    "name",
    "organisation_type"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "schema": {
        "$ref": "UUID.schema.json"
      },
      "readOnly": true,
      "description": "The ID of the European Union organisation."
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "readOnly": true,
      "description": "The RDF resource URI of the European Union organisation."
    },
    "name": {
      "type": "string",
      "description": "The European Union organisation name.",
      "minLength": 1,
      "maxLength": 255
    },
    "organisation_type": {
      "type": "string",
      "description": "The European Union organisation type.",
      "enum": [
        "european_union_agency",
        "european_union_body",
        "european_union_institution"
      ]
    }
  }
}
