{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "interpretation"
  ],
  "additionalProperties": false,
  "properties": {
    "interpretation": {
      "type": "string",
      "description": "The interpretation of the statement.",
      "enum": [
        "negative",
        "neutral",
        "positive"
      ]
    },
    "judgement": {
      "type": "string",
      "description": "The personal opinion on the report."
    }
  }
}
